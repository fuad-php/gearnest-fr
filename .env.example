# ---------------------------------------------------------------------------
# GearNest client — copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# BetterAuth (server-side)
# BETTER_AUTH_SECRET: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (used by the BetterAuth adapter)
MongoDB_URI=

# Google social login (optional — button is disabled when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe and imgbb keys belong in the SERVER .env only.
# Never expose STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET or IMGBB_API_KEY here.
